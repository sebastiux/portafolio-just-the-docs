  (symbol (lib_id "power:PWR_FLAG") (at 101.60 35.56 0) (unit 1) (in_bom no) (on_board no) (dnp no) (uuid ba4a5a56-7499-4c4e-9901-2f6bfbe20f00) (property "Reference" "#FLG16" (at 101.60 35.56 0) (effects (font (size 1.27 1.27)) (justify left) hide)) (property "Value" "PWR_FLAG" (at 101.60 31.75 0) (effects (font (size 1.27 1.27)) hide)) (property "Footprint" "" (at 101.60 35.56 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "~" (at 101.60 35.56 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid f2b370f2-b0e8-4d99-b0b8-c89ce535603e)) (instances (project "tarjeta_brazo" (path "/2fdda228-9e9d-4497-bf2a-ca52ada76c5e" (reference "#FLG16") (unit 1)))))
  (wire (pts (xy 101.60 35.56) (xy 101.60 40.64)) (stroke (width 0) (type default)) (uuid 8bf724e5-88df-4a4e-83bd-175b16072f17))
  (label "+5V_MOD" (at 101.60 40.64 0) (fields_autoplaced) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 72b00d15-e06c-4422-98fe-c32fd3e17b13))
  (text "Notas:" (at 20 168 0) (effects (font (size 1.5 1.5) bold) (justify left bottom)) (uuid a33ed50a-96d7-4809-809e-f0b992c3390c))
  (text "1. Los servos se alimentan directo de +5V (fuente externa de 5 V, 3 A); el USB solo alimenta al ESP32-C3." (at 20 172 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 17be82ad-6f86-45ca-9631-44f85f11c925))
  (text "2. D1 evita que la fuente externa regrese corriente al USB de la computadora." (at 20 176 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 08232b10-6452-4ee3-91ba-23643d2c13a5))
  (text "3. R2 baja el tope de los potenciómetros a ~2.54 V: el ADC del ESP32-C3 mide bien hasta 2.5 V (atenuación de 12 dB)." (at 20 180 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 0e231943-33f9-4a03-8a95-f5a1161e006c))
  (text "4. Con el interruptor cerrado a GND la pinza abre (GPIO10 con pull-up interno)." (at 20 184 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 1869bbae-0b29-4a2c-846b-98de5a558d06))
  (text "5. GPIO2, GPIO8 y GPIO9 son pines de arranque; GPIO8 tiene el LED de la placa." (at 20 188 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 548ba8d7-926e-4000-be11-09df1709ed74))
  (sheet_instances (path "/" (page "1")))
)
